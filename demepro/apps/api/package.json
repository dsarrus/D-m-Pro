{
  "name": "@demepro/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "db:generate": "prisma generate --config ../../prisma7.config.ts",
    "db:migrate": "prisma migrate dev --config ../../prisma7.config.ts",
    "db:migrate:deploy": "prisma migrate deploy --config ../../prisma7.config.ts",
    "db:seed": "prisma db seed --config ../../prisma7.config.ts",
    "db:studio": "prisma studio --config ../../prisma7.config.ts",
    "db:validate": "prisma validate --config ../../prisma7.config.ts",
    "db:format": "prisma format --config ../../prisma7.config.ts",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:watch": "vitest",
    "dev": "echo \"dev\"",
    "build": "echo \"build\""
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "prisma": "7.10.0",
    "supertest": "^7.3.1",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.6.5"
  }
}
